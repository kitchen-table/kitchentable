{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitchen Table",
  "version": "0.1.0",
  "identifier": "app.kitchentable.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ui dev",
    "beforeBuildCommand": "pnpm -C ui build && node scripts/stage-daemon.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kitchen Table",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/kt-daemon"],
    "category": "Productivity",
    "shortDescription": "A home for your small software.",
    "longDescription": "Kitchen Table turns any folder on your computer into a live web app that the people you choose can open on their phones.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
